<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Drops onto PATH as curl.exe, so scripts cannot tell the difference. -->
    <AssemblyName>curl</AssemblyName>
    <RootNamespace>Curl.Console</RootNamespace>
    <!--
      Native ahead-of-time is the shipping configuration, but it needs the MSVC
      linker from the "Desktop development with C++" workload. Defaulting it on
      makes a plain `dotnet publish` fail on any machine without that workload,
      including build agents, so it is opt-in:
          dotnet publish Curl.Console -c Release -p:PublishAot=true
      IsAotCompatible stays on for every library (Directory.Build.props), so the
      trim and AOT analyzers still catch incompatible code at build time.
    -->
    <PublishAot Condition=" '$(PublishAot)' == '' ">false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curl.Authentication.UnitLibrary\Curl.Authentication.UnitLibrary.csproj" />
    <ProjectReference Include="..\Curl.Cli.UnitLibrary\Curl.Cli.UnitLibrary.csproj" />
